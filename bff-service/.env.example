APP_PORT=3000

# Base URL of the Product Service (API Gateway stage URL)
PRODUCT_SERVICE_URL=https://your-api-id.execute-api.eu-north-1.amazonaws.com/prod

# Base URL of the Cart Service (Elastic Beanstalk environment URL)
CART_SERVICE_URL=https://your-cart-env.eu-north-1.elasticbeanstalk.com

# TTL (ms) for the getProductsList response cache. Optional, defaults to 120000 (2 minutes)
CACHE_TTL_MS=120000
